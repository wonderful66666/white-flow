  "tokenColors": [
    {
      "name": "Ink",
      "scope": [
        "source",
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.interpolation"
      ],
      "settings": {
        "foreground": "#171A21",
        "fontStyle": ""
      }
    },
    {
      "name": "Structure",
      "scope": [
        "punctuation",
        "keyword.operator",
        "meta.brace",
        "storage.modifier.import",
        "entity.name.namespace",
        "entity.name.module",
        "support.other.namespace",
        "entity.name.package",
        "keyword.control.ternary",
        "keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "#3F3F46",
        "fontStyle": ""
      }
    },
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.block.documentation",
        "comment.line.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#5E6574",
        "fontStyle": ""
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "variable.language",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.instanceof",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#6D20D9",
        "fontStyle": ""
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call entity.name.function",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#1847D1",
        "fontStyle": ""
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.struct",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.java",
        "storage.type.generic",
        "storage.type.primitive",
        "storage.type.object.array",
        "entity.name.type.primitive",
        "entity.name.type.numeric",
        "entity.name.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#00605E",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "punctuation.definition.string",
        "constant.character.char"
      ],
      "settings": {
        "foreground": "#046426",
        "fontStyle": ""
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder",
        "punctuation.definition.interpolation",
        "entity.name.type.lifetime",
        "punctuation.definition.lifetime",
        "entity.name.type.option",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#814801",
        "fontStyle": ""
      }
    },
    {
      "name": "Meta",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro",
        "meta.attribute",
        "punctuation.definition.attribute",
        "storage.type.annotation",
        "punctuation.definition.annotation",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.preprocessor",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#AC0448",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name"
      ],
      "settings": {
        "foreground": "#171A21",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1847D1",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5E6574",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#046426",
        "fontStyle": ""
      }
    },
    {
      "name": "Danger",
      "scope": [
        "markup.deleted",
        "invalid"
      ],
      "settings": {
        "foreground": "#AF0811",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#814801",
        "fontStyle": ""
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#6D20D9",
    "selfKeyword": "#6D20D9",
    "function": "#1847D1",
    "method": "#1847D1",
    "macro": "#AC0448",
    "decorator": "#AC0448",
    "attribute": "#AC0448",
    "builtinAttribute": "#AC0448",
    "annotation": "#AC0448",
    "class": "#00605E",
    "struct": "#00605E",
    "interface": "#00605E",
    "enum": "#00605E",
    "type": "#00605E",
    "typeParameter": "#00605E",
    "builtinType": "#00605E",
    "typeAlias": "#00605E",
    "namespace": "#3F3F46",
    "operator": "#3F3F46",
    "variable": "#171A21",
    "parameter": "#171A21",
    "property": "#171A21",
    "enumMember": "#814801",
    "lifetime": "#814801",
    "number": "#814801",
    "boolean": "#814801",
    "escapeSequence": "#814801",
    "formatSpecifier": "#814801",
    "string": "#046426",
    "comment": "#5E6574",
    "*.declaration": {
      "bold": false,
      "italic": false
    },
    "*.readonly": {
      "bold": false,
      "italic": false
    }
  }
}
