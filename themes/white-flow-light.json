    "scrollbarSlider.hoverBackground": "#BDBDC680",
    "scrollbarSlider.activeBackground": "#A1A1AA99",
    "settings.headerForeground": "#27272A",
    "settings.modifiedItemIndicator": "#2563EB",
    "textLink.foreground": "#2563EB"
  },
  "tokenColors": [
    {
      "scope": [
        "source"
      ],
      "settings": {
        "foreground": "#27272A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword",
        "storage"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator",
        "punctuation"
      ],
      "settings": {
        "foreground": "#27272A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#047857",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#73727C",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1D4ED8",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "support.class.component",
        "meta.import variable.other"
      ],
      "settings": {
        "foreground": "#0369A1",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "variable",
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#27272A",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#0369A1",
        "fontStyle": ""
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#27272A",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "keyword": "#7C3AED",
    "function": "#1D4ED8",
    "method": "#1D4ED8",
    "class": "#0369A1",
    "interface": "#0369A1",
    "type": "#0369A1",
    "typeParameter": "#0369A1",
    "namespace": "#0369A1",
    "variable": "#27272A",
    "parameter": "#27272A",
    "property": "#27272A",
    "enumMember": "#B45309",
    "string": "#047857",
    "number": "#B45309",
    "comment": "#73727C",
    "*.declaration": {
      "bold": false,
      "italic": false
    },
    "*.readonly": {
      "bold": false,
      "italic": false
    }
  }
}
